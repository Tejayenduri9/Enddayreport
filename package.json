{
  "name": "restaurant-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:karavalli": "vite --mode karavalli",
    "dev:full": "npm run build && wrangler pages dev dist --compatibility-flag nodejs_compat",
    "build": "vite build",
    "build:karavalli": "vite build --mode karavalli",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\" \"server/**/*.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:rules:karavalli": "cp firestore.rules firestore.rules.spice && cp firestore.rules.karavalli firestore.rules && firebase --project karavalli deploy --only firestore:rules && cp firestore.rules.spice firestore.rules"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.9.2",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
